<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Relacion1E01_AlexVT.MainPage">

    <VerticalStackLayout x:Name="vslContenido" Spacing="10">
        <Label Text="Introduzca su nombre"
               HorizontalOptions="Center"/>
        <Entry x:Name="eNombre"/>
        
        <Label Text="Introduzca sus apellidos"
               HorizontalOptions="Center"/>
        <Entry x:Name="eApellidos"/>

        <Label Text="Introduzca su edad"
               HorizontalOptions="Center"/>
        <Entry x:Name="eEdad"/>

        <Button x:Name="bAcceder"
                Text="Acceder"
                Clicked="bAccederClick"/>
        
        <Label x:Name="lResultadoAcceso" HorizontalOptions="Center"/>
    </VerticalStackLayout>

</ContentPage>
